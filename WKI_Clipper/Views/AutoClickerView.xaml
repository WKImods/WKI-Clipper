<UserControl x:Class="WKI_Clipper.Views.AutoClickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ac="clr-namespace:WKI_Clipper.Views.AutoClicker">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- Always on top: the warning and the status row of the native clicker; below them the sub-tabs. -->
        <StackPanel>

            <!-- Warning: only a warning, nothing is locked -->
            <Border x:Name="WarningBanner" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="WarningText" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                    <Button x:Name="AckBtn" HorizontalAlignment="Left" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- Status row: "Clicker bereit" and "Mausbewegung bereit", the clicker's state pill, Start/Stop -->
            <Border x:Name="StatusSection" Background="{DynamicResource PanelBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <CheckBox x:Name="ArmedBox" />
                            <CheckBox x:Name="PatternsArmedBox" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="RetryBtn" Margin="8,0,0,0" Visibility="Collapsed" />
                            <Button x:Name="StartStopBtn" Style="{StaticResource AccentButton}" Margin="8,0,0,0" MinWidth="90" />
                        </StackPanel>
                    </Grid>
                    <Border x:Name="Pill" HorizontalAlignment="Left" CornerRadius="10" Padding="10,3" Margin="0,8,0,0"
                            Background="{DynamicResource SoftFillBrush}" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}">
                        <TextBlock x:Name="PillText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                    </Border>
                    <StackPanel x:Name="ConflictRows" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Sub-tabs -->
            <WrapPanel x:Name="SubTabStrip" Margin="0,0,0,10">
                <RadioButton x:Name="TabSimple"   GroupName="AC" Style="{StaticResource TabButtonStyle}" Tag="simple"   Checked="OnSubTab" />
                <RadioButton x:Name="TabAdvanced" GroupName="AC" Style="{StaticResource TabButtonStyle}" Tag="advanced" Checked="OnSubTab" />
                <RadioButton x:Name="TabZones"    GroupName="AC" Style="{StaticResource TabButtonStyle}" Tag="zones"    Checked="OnSubTab" />
                <RadioButton x:Name="TabPoints"   GroupName="AC" Style="{StaticResource TabButtonStyle}" Tag="points"   Checked="OnSubTab" />
                <RadioButton x:Name="TabPatterns" GroupName="AC" Style="{StaticResource TabButtonStyle}" Tag="patterns" Checked="OnSubTab" />
                <RadioButton x:Name="TabPresets"  GroupName="AC" Style="{StaticResource TabButtonStyle}" Tag="presets"  Checked="OnSubTab" />
            </WrapPanel>

            <!-- All panels stay in the tree and are only collapsed (like the Gaming Utilities tabs). -->
            <Grid>
                <ac:SimpleClickerPanel   x:Name="SimplePanel" />
                <ac:AdvancedClickerPanel x:Name="AdvancedPanel"   Visibility="Collapsed" />
                <ac:ZonesSafetyPanel     x:Name="ZonesPanel"      Visibility="Collapsed" />
                <ac:ClickPointsPanel     x:Name="PointsPanel"     Visibility="Collapsed" />
                <ac:MousePatternsPanel   x:Name="PatternsPanel"   Visibility="Collapsed" />
                <ac:PresetsStatsPanel    x:Name="PresetsPanel"    Visibility="Collapsed" />
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
