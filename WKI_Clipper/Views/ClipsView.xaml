<UserControl x:Class="WKI_Clipper.Views.ClipsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel LastChildFill="True">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource HeadingStyle}" Text="Clips &amp; Screenshots" VerticalAlignment="Center" />
            <StackPanel x:Name="FilterRow" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="RefreshBtn" Content="Aktualisieren" Padding="12,6" Margin="0,0,8,0" />
                <Button x:Name="OpenClipsFolderBtn" Content="Clips-Ordner" Padding="12,6" Margin="0,0,8,0" />
                <Button x:Name="OpenShotsFolderBtn" Content="Screenshots-Ordner" Padding="12,6" />
            </StackPanel>
        </DockPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <ToggleButton x:Name="FavOnly" DockPanel.Dock="Right" Content="★ Favoriten"
                          Template="{StaticResource LauncherToggleTemplate}"
                          Padding="10,6" Margin="8,0,0,0"
                          Foreground="{StaticResource TextBrush}" Cursor="Hand"
                          Checked="OnFavOnlyChanged" Unchecked="OnFavOnlyChanged" />
            <ComboBox x:Name="GameFilter" DockPanel.Dock="Right" MinWidth="150" Margin="8,0,0,0"
                      SelectionChanged="OnGameFilterChanged" />
            <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" />
        </DockPanel>

        <!-- Shown while notes/stars cannot be read or saved (file locked, disk problem) -->
        <Border x:Name="MetaWarning" DockPanel.Dock="Top" Visibility="Collapsed"
                Background="#26E5484D" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                CornerRadius="10" Padding="12,8" Margin="0,0,0,10">
            <TextBlock x:Name="MetaWarningText" TextWrapping="Wrap" />
        </Border>

        <TextBlock x:Name="EmptyHint"
                   DockPanel.Dock="Top"
                   Visibility="Collapsed"
                   Style="{StaticResource MutedStyle}"
                   Text="Keine Dateien gefunden. Drück F9 für nen Clip oder F10 für nen Screenshot."
                   Margin="0,12,0,0" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ItemsContainer" />
        </ScrollViewer>
    </DockPanel>
</UserControl>
