<UserControl x:Class="WKI_Clipper.Views.MixerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="ScopeLine" Grid.Row="0" Margin="2,0,2,7"
                   Style="{StaticResource MutedStyle}" TextWrapping="Wrap" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Rows" />
        </ScrollViewer>
        <TextBlock x:Name="StatusLine" Grid.Row="2" Margin="2,8,2,0"
                   Style="{StaticResource MutedStyle}" TextWrapping="Wrap" />
    </Grid>
</UserControl>
