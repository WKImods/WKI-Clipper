<Window x:Class="WKI_Clipper.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Widget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        MinWidth="220" MinHeight="140"
        SizeToContent="Manual">
    <Window.Resources>
        <!-- Chrome icon button (close) -->
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SoftFillHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <TextBlock x:Name="Pin" Text="&#xE718;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SoftFillHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pin" Property="Text" Value="&#xE840;" />
                                <Setter TargetName="Pin" Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Glass surface: violet, translucent, faint highlight at the top, hairline edge -->
    <Border x:Name="Surface" CornerRadius="16" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar (drag handle) -->
            <Grid Grid.Row="0" Height="42" Background="Transparent" MouseLeftButtonDown="OnTitleDrag">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <ContentControl x:Name="IconHost" Width="18" Height="18" Margin="0,0,10,0"
                                    VerticalAlignment="Center" Focusable="False" />
                    <TextBlock x:Name="TitleText" VerticalAlignment="Center"
                               FontWeight="SemiBold" FontSize="13.5"
                               Foreground="{StaticResource TextBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,7,0">
                    <!-- Always-visible opacity slider — anchored in the title bar so
                         adjusting transparency is one drag, no popup to open first. -->
                    <Slider x:Name="OpacitySlider" Width="64" Minimum="0.3" Maximum="1.0"
                            VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ToggleButton x:Name="PinButton" Style="{StaticResource PinToggle}"
                                  ToolTip="Pin"
                                  Checked="OnPinChanged" Unchecked="OnPinChanged" />
                    <Button x:Name="CloseButton" Style="{StaticResource ChromeButton}"
                            Click="OnClose">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Content host -->
            <Border x:Name="ContentHost" Grid.Row="1" Padding="14,4,14,14" />

            <!-- Resize grip (bottom-right) -->
            <Thumb x:Name="ResizeThumb" Grid.Row="1"
                   Width="18" Height="18"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="0,0,3,3"
                   Cursor="SizeNWSE" Opacity="0.55"
                   DragDelta="OnResize" DragCompleted="OnResizeCompleted">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Path Data="M 14 4 L 4 14 M 14 9 L 9 14" Stroke="{StaticResource FaintBrush}"
                                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
