<Window x:Class="WKI_Clipper.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Widget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        MinWidth="220" MinHeight="140"
        SizeToContent="Manual">
    <Window.Resources>
        <!-- Chrome icon button (pin / close) -->
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <!-- Simple push-pin glyph -->
                            <Path x:Name="Pin" Width="14" Height="14" Stretch="Uniform"
                                  Fill="{StaticResource MutedBrush}"
                                  Data="M9,2 L15,8 L12.5,8.5 L11,13 L9.5,9.5 L4,15 L9.5,9.5 L8.5,7.5 L9,2 Z" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pin" Property="Fill" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="8" Background="#F21E1E24" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar (drag handle) -->
            <Grid Grid.Row="0" Height="34" Background="#FF16161B" MouseLeftButtonDown="OnTitleDrag">
                <Border Background="Transparent" CornerRadius="8,8,0,0" />
                <TextBlock x:Name="TitleText" VerticalAlignment="Center" Margin="12,0,0,0"
                           FontWeight="SemiBold" FontSize="12"
                           Foreground="{StaticResource TextBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
                    <ToggleButton x:Name="PinButton" Style="{StaticResource PinToggle}"
                                  ToolTip="Pin"
                                  Checked="OnPinChanged" Unchecked="OnPinChanged" />
                    <Button x:Name="CloseButton" Style="{StaticResource ChromeButton}"
                            Content="✕" FontSize="13" Click="OnClose" />
                </StackPanel>
            </Grid>

            <!-- Content host -->
            <Border x:Name="ContentHost" Grid.Row="1" Padding="12" />

            <!-- Resize grip (bottom-right) -->
            <Thumb x:Name="ResizeThumb" Grid.Row="1"
                   Width="16" Height="16"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Cursor="SizeNWSE" Opacity="0.5"
                   DragDelta="OnResize">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Path Data="M 16 0 L 16 16 L 0 16 Z" Fill="{StaticResource MutedBrush}" />
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
