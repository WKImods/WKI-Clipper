<UserControl x:Class="WKI_Clipper.Views.CrosshairView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel LastChildFill="True">
        <!-- Header: master toggle + import -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <CheckBox x:Name="EnabledBox" Content="Crosshair anzeigen" FontWeight="SemiBold" />
            <TextBlock x:Name="HotkeyHint" Style="{StaticResource MutedStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button x:Name="ImportBtn" Content="PNG hinzufügen…" Style="{StaticResource AccentButton}" />
            <Button x:Name="FolderBtn" Content="Ordner öffnen" Margin="0,6,0,0" />
        </StackPanel>

        <!-- Sliders -->
        <StackPanel x:Name="SlidersPanel" DockPanel.Dock="Bottom" Margin="0,10,0,0" />

        <!-- Library -->
        <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="8">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="LibHeading" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="4,2,4,8" />
                <TextBlock x:Name="EmptyHint" DockPanel.Dock="Top" Style="{StaticResource MutedStyle}"
                           TextWrapping="Wrap" Margin="4,0,4,8" Visibility="Collapsed" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="LibraryContainer" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
