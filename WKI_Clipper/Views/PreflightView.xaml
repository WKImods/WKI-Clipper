<UserControl x:Class="WKI_Clipper.Views.PreflightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel x:Name="ChecksPanel" />
                <Expander x:Name="ConfigExpander" Margin="0,8,0,0"
                          Foreground="{StaticResource MutedBrush}">
                    <StackPanel x:Name="ConfigPanel" Margin="0,8,0,0" />
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="CountdownText" Grid.Row="1" Margin="0,10,0,0"
                   FontSize="15" FontWeight="SemiBold" TextAlignment="Center"
                   Visibility="Collapsed" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="GoLiveBtn" Style="{StaticResource AccentButton}"
                    Padding="14,8" MinWidth="150" Click="OnGoLive" />
            <Button x:Name="CancelBtn" Margin="8,0,0,0" Padding="14,8"
                    Visibility="Collapsed" Click="OnCancelSequence" />
        </StackPanel>
    </Grid>
</UserControl>
