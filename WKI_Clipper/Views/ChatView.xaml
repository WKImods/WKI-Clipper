<UserControl x:Class="WKI_Clipper.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <Ellipse x:Name="ConnDot" Width="9" Height="9" VerticalAlignment="Center"
                     Margin="0,0,7,0" Fill="#555555" />
            <Button x:Name="ReconnectBtn" DockPanel.Dock="Right" Padding="8,3"
                    Click="OnReconnect" />
            <TextBox x:Name="ChannelBox" MinWidth="90" Margin="0,0,6,0"
                     KeyDown="OnChannelKey" LostFocus="OnChannelCommit" />
        </DockPanel>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      ScrollChanged="OnScrollChanged">
            <StackPanel x:Name="Messages" />
        </ScrollViewer>
    </Grid>
</UserControl>
