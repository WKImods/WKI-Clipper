<UserControl x:Class="WKI_Clipper.Views.SourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="ScenesHeader" Grid.Row="0" Margin="2,0,2,4"
                   Style="{StaticResource MutedStyle}" />
        <WrapPanel x:Name="ScenePanel" Grid.Row="1" Margin="0,0,0,10" />

        <TextBlock x:Name="SourcesHeader" Grid.Row="2" Margin="2,0,2,4"
                   Style="{StaticResource MutedStyle}" />
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ItemsPanel" />
        </ScrollViewer>

        <TextBlock x:Name="StatusLine" Grid.Row="4" Margin="2,8,2,0"
                   Style="{StaticResource MutedStyle}" TextWrapping="Wrap" />
    </Grid>
</UserControl>
